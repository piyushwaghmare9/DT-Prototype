# CampusX — Environment Configuration
# Copy this file to .env and fill in your values

# MongoDB
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/campusx?retryWrites=true&w=majority
DB_NAME=campusx

# JWT
JWT_SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# App
APP_NAME=CampusX
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# CORS - Frontend URL
FRONTEND_URL=http://localhost:5173

# College email domain (leave empty to allow any domain)
ALLOWED_EMAIL_DOMAIN=

# File uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# Optional: SMTP for email verification
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@campusx.local
